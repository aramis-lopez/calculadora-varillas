{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "🏗️ Calculadora de Varillas",
      "size": "Medium",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "Container",
      "$when": "${hayCalculo}",
      "spacing": "Small",
      "items": [
        {
          "type": "TextBlock",
          "text": "Último cálculo · ${fecha}",
          "isSubtle": true,
          "size": "Small",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${columna}",
          "spacing": "Medium",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${armado}",
          "size": "Large",
          "weight": "Bolder",
          "color": "Accent",
          "spacing": "Small",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${detalle}",
          "isSubtle": true,
          "size": "Small",
          "spacing": "Small",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${guardados}",
          "isSubtle": true,
          "size": "Small",
          "spacing": "Medium"
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${sinCalculo}",
      "text": "Aún no hay cálculos guardados. Abre la app para calcular tu primera columna.",
      "wrap": true,
      "spacing": "Medium"
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Nuevo cálculo", "verb": "nuevo" },
    { "type": "Action.Execute", "title": "Ver historial", "verb": "historial" }
  ]
}
